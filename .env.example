# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Configuration for sending loan applications and document attachments to ssnwealthestates@gmail.com
# Configure your SMTP credentials (e.g. Gmail App Password, SendGrid, Amazon SES, Brevo, or custom SMTP server)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="ssnwealthestates@gmail.com"
SMTP_PASS=""
NOTIFICATION_EMAIL="ssnwealthestates@gmail.com"
FROM_EMAIL="SSN Wealth Capital <ssnwealthestates@gmail.com>"

# Indian Payment Gateway Configuration (Razorpay)
# For production or test transactions via UPI, Credit/Debit Cards, Net Banking
# Obtain Key ID and Key Secret from your Razorpay Dashboard (Settings > API Keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Official Meta WhatsApp Cloud API / WhatsApp Business API Configuration
# Obtain credentials from Meta for Developers (developers.facebook.com > Your App > WhatsApp > API Setup)
# 1. WHATSAPP_PHONE_NUMBER_ID: The unique Phone Number ID assigned by Meta Cloud API
# 2. WHATSAPP_ACCESS_TOKEN: Permanent System User Access Token or Temporary Access Token
# Admin Panel Authentication Credentials
# Default credentials: username = SSN, password = sathya@1995
ADMIN_USERNAME="SSN"
ADMIN_PASSWORD="sathya@1995"


